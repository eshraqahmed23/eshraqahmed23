# Claude API (required for extraction)
ANTHROPIC_API_KEY=sk-ant-...

# Azure AD service principal with Power BI access (required for the push step)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret

# Power BI workspace that will hold the push dataset
POWERBI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# Optional; defaults to "Property Reports"
POWERBI_DATASET_NAME=Property Reports
