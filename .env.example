# --- Business identity (used to personalize AI-drafted messages + website) ---
BUSINESS_NAME=Northline Heating & Air
BUSINESS_TYPE=HVAC (heating & air conditioning) company
AGENT_NAME=the Northline team
AGENT_EMAIL=service@northlinehvac.example
# Phone number shown on the website and in customer messages.
BUSINESS_PHONE=(555) 212-9080

# --- AI (OPTIONAL) ---
# Leave this commented out to run without AI: the app auto-uses its built-in
# email wording and still sends real emails/SMS. Uncomment and paste a real key
# from https://platform.claude.com only if you want Claude to personalize each
# message. (Do NOT leave the "sk-ant-..." placeholder uncommented — an invalid
# key makes every submission fail with a 401.)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-4-8
# MOCK_AI=true            # run the whole workflow without an API key (dev only)

# --- CRM (optional — omit to use the built-in local JSON CRM) ---
# HUBSPOT_ACCESS_TOKEN=pat-...

# --- Email via Gmail (recommended — omit for dry-run logging) ---
# GMAIL_USER is your Gmail address. GMAIL_APP_PASSWORD is a 16-character
# App Password from https://myaccount.google.com/apppasswords (requires
# 2-Step Verification turned on). It is NOT your normal Gmail password.
# GMAIL_USER=youraddress@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop

# --- Email via SendGrid (alternative to Gmail) ---
# SENDGRID_API_KEY=SG....
# FROM_EMAIL=alex@hilltoprealty.com

# --- SMS via Twilio (optional — omit for dry-run logging) ---
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+15550001111

# How many days after the welcome email to send the single follow-up.
# Defaults to 7 (one week).
# FOLLOWUP_DAYS=7

# Testing override (in minutes) so you don't wait a week — e.g.
# FOLLOWUP_MINUTES=1 sends the follow-up a minute later. Leave unset for real use.
# FOLLOWUP_MINUTES=1

# A lead with the same email won't be contacted again within this many days
# (prevents repeat form submissions from re-emailing the same person).
# Default is 30. Set to 0 to disable.
# DEDUPE_DAYS=30

# Optional: log every lead as a row in a Google Sheet in real time.
# Paste the web-app URL from a Google Apps Script deployment (see README).
# SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# PORT=3000
